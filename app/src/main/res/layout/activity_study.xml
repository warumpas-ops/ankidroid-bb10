<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_study"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/window_bg">

    <!-- Top Compact Header & Progress Bar (32dp) -->
    <LinearLayout
        android:id="@+id/ll_study_progress"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="10dp"
        android:background="#FFFFFF">

        <ImageButton
            android:id="@+id/btn_study_back"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_back"
            android:scaleType="centerInside"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/tv_deck_study_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginLeft="4dp" />

        <ImageButton
            android:id="@+id/btn_study_audio"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_audio"
            android:scaleType="centerInside"
            android:contentDescription="Replay Audio"
            android:layout_marginRight="6dp" />

        <!-- 3 Pill Badges -->
        <TextView
            android:id="@+id/tv_badge_new"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_new"
            android:textColor="@color/count_new"
            android:textSize="11sp"
            android:textStyle="bold"
            android:minWidth="26dp"
            android:gravity="center"
            android:layout_marginRight="4dp"
            android:text="0" />

        <TextView
            android:id="@+id/tv_badge_learn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_learn"
            android:textColor="@color/count_learn"
            android:textSize="11sp"
            android:textStyle="bold"
            android:minWidth="26dp"
            android:gravity="center"
            android:layout_marginRight="4dp"
            android:text="0" />

        <TextView
            android:id="@+id/tv_badge_review"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_review"
            android:textColor="@color/count_review"
            android:textSize="11sp"
            android:textStyle="bold"
            android:minWidth="26dp"
            android:gravity="center"
            android:text="0" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Card Canvas Viewport -->
    <WebView
        android:id="@+id/wv_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/window_bg" />

    <!-- Finished Message -->
    <LinearLayout
        android:id="@+id/tv_done"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎉"
            android:textSize="36sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Congratulations!"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/count_review"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You have finished this deck for now."
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_done_back"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/btn_show_answer_bg"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="13sp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:text="Back to Decks" />

    </LinearLayout>

    <!-- Bottom Answer Area Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 1. Front: SHOW ANSWER Button -->
    <LinearLayout
        android:id="@+id/ll_front_answer"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:padding="4dp"
        android:descendantFocusability="blocksDescendants"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/btn_show_answer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/btn_show_answer_bg"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="SHOW ANSWER  [Space]" />

    </LinearLayout>

    <!-- 2. Back: 4 Rating Buttons (Again, Hard, Good, Easy) -->
    <LinearLayout
        android:id="@+id/ll_back_ratings"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="3dp"
        android:descendantFocusability="blocksDescendants"
        android:visibility="gone">

        <!-- Again (1) -->
        <LinearLayout
            android:id="@+id/btn_again"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/btn_rating_bg"
            android:clickable="true"
            android:focusable="true"
            android:descendantFocusability="blocksDescendants"
            android:layout_marginRight="2dp">

            <TextView
                android:id="@+id/tv_ivl_again"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&lt;1m"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:duplicateParentState="true" />

            <TextView
                android:id="@+id/tv_lbl_again"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Again (1)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/btn_again"
                android:duplicateParentState="true" />

        </LinearLayout>

        <!-- Hard (2) -->
        <LinearLayout
            android:id="@+id/btn_hard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/btn_rating_bg"
            android:clickable="true"
            android:focusable="true"
            android:descendantFocusability="blocksDescendants"
            android:layout_marginRight="2dp">

            <TextView
                android:id="@+id/tv_ivl_hard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10m"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:duplicateParentState="true" />

            <TextView
                android:id="@+id/tv_lbl_hard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hard (2)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/btn_hard"
                android:duplicateParentState="true" />

        </LinearLayout>

        <!-- Good (3 / Space) -->
        <LinearLayout
            android:id="@+id/btn_good"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/btn_rating_bg"
            android:clickable="true"
            android:focusable="true"
            android:descendantFocusability="blocksDescendants"
            android:layout_marginRight="2dp">

            <TextView
                android:id="@+id/tv_ivl_good"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1d"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:duplicateParentState="true" />

            <TextView
                android:id="@+id/tv_lbl_good"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good (3)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/btn_good"
                android:duplicateParentState="true" />

        </LinearLayout>

        <!-- Easy (4) -->
        <LinearLayout
            android:id="@+id/btn_easy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/btn_rating_bg"
            android:clickable="true"
            android:focusable="true"
            android:descendantFocusability="blocksDescendants">

            <TextView
                android:id="@+id/tv_ivl_easy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4d"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:duplicateParentState="true" />

            <TextView
                android:id="@+id/tv_lbl_easy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Easy (4)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/btn_easy"
                android:duplicateParentState="true" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>